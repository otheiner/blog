---
layout: none
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0"
     xmlns:atom="http://www.w3.org/2005/Atom"
     xmlns:content="http://purl.org/rss/1.0/modules/content/"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:itunes="http://www.itunes.com/dtds/podcast-1.0.dtd">
<channel>
  <title>{{ site.title | xml_escape }}</title>
  <description>{{ site.description | xml_escape }}</description>
  <link>{{ site.url }}{{ site.baseurl }}/</link>
  <atom:link href="{{ site.url }}{{ site.baseurl }}/feed.xml" rel="self" type="application/rss+xml"/>
  <language>{{ site.lang | default: "en" }}</language>
  <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
  <generator>Jekyll</generator>

  {% for post in site.posts limit:30 %}
  <item>
    <title>{{ post.title | xml_escape }}</title>
    <link>{{ post.url | absolute_url }}</link>
    <guid isPermaLink="true">{{ post.url | absolute_url }}</guid>
    <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>

    {%- if post.author %}
    <dc:creator>{{ post.author | xml_escape }}</dc:creator>
    {%- endif %}

    {%- if post.tags %}
    {%- for tag in post.tags %}
    <category>{{ tag | xml_escape }}</category>
    {%- endfor %}
    {%- endif %}

    <description>{{ post.excerpt | strip_html | xml_escape }}</description>
    <content:encoded><![CDATA[{{ post.content }}]]></content:encoded>

    {%- if post.audio %}
    <enclosure url="{{ post.audio | absolute_url }}"
               length="{{ post.audio | audio_file_size }}" type="audio/mpeg"/>
    <itunes:duration>{{ post.audio | audio_duration }}</itunes:duration>
    {%- endif %}
  </item>
  {% endfor %}

</channel>
</rss>
